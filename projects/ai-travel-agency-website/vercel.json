{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|styles\\.css|app\\.js|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
